		"name": "Order Service",
		"description": "Collection kiểm thử Order Service (Slot 5) - Base URL: http://localhost:8081",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "01 - Create Order (Success - Happy Path)",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"skuCode\": \"iphone_15\",\n  \"price\": 1000,\n  \"quantity\": 1\n}"
				},
				"url": {
					"raw": "{{order_base_url}}/api/order",
					"host": [
						"{{order_base_url}}"
					],
					"path": [
						"api",
						"order"
					]
				}
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 201\", function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"pm.test(\"Response body is correct message\", function () {",
							"    pm.expect(pm.response.text()).to.eql(\"Order Placed Successfully\");",
							"});"
						],
						"type": "text/javascript"
					}
				}
			]
		},
